# Titrator firmware defaults. sdkconfig is generated from this file; change
# settings here (or with menuconfig + `idf.py save-defconfig`), not in sdkconfig.

CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3-WROOM-1-N16R8: 16 MB quad flash and 8 MB octal PSRAM, both 3.3 V.
# QIO flash and octal PSRAM at 80 MHz is a supported pair.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# One factory app (1.5 MB), NVS and a core dump partition. No OTA.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# BLE peripheral on NimBLE: GATT server only, one connection, MTU 247.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# The per-step MCPWM interrupt and what it calls stay in IRAM.
CONFIG_MCPWM_ISR_HANDLER_IN_IRAM=y
CONFIG_MCPWM_CTRL_FUNC_IN_IRAM=y
CONFIG_PCNT_CTRL_FUNC_IN_IRAM=y

# Logging: INFO by default, DEBUG can be enabled per tag at runtime (`log` in
# the debug shell).
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Fatal errors leave a core dump in flash: `idf.py coredump-info`. It gets its
# own stack, so that a stack overflow can still be dumped.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_STACK_SIZE=1792

# `tasks` in the debug shell (main/debug_shell.c).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
